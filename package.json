{
  "name": "async-react-workshop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test server/api.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.72.0",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.12.4"
}
